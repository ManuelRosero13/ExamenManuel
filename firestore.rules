rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /usuarios/{uid}/equipo/{pokemonId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
